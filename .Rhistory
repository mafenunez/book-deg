recodes = c("
'No sé' = NA;
'Prefiero no responder' = NA"),
as.factor = TRUE,
levels = c("Muy insatisfecho(a)",
"Insatisfecho(a)",
"Ni satisfecho(a) ni insatisfecho(a)",
"Satisfecho(a)",
"Muy satisfecho(a)"))
