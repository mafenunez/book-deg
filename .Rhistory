#| echo: false
#| warning: false
#| message: false
separar_multirespuesta <- function(datos, variable, prefijo = "cat_") {
datos <- datos %>%
mutate(.id_fila = row_number())
# 1. Limpiar caracteres invisibles y espacios, luego separar por ";"
largo <- datos %>%
select(.id_fila, {{ variable }}) %>%
mutate(
texto = as.character({{ variable }}),
texto = str_replace_all(texto, "[\u2060\u200b\ufeff]", ""), # quita word joiner, zero-width space, BOM
texto = str_trim(texto)
) %>%
filter(!is.na(texto), texto != "") %>%
separate_rows(texto, sep = ";") %>%
mutate(
texto = str_trim(texto),
texto = str_replace_all(texto, "\\s+", " ") # colapsa espacios múltiples
) %>%
filter(texto != "")
# 2. Detectar categorías únicas (ya limpias)
categorias <- sort(unique(largo$texto))
message("Categorías detectadas (", length(categorias), "):")
print(categorias)
# 3. Pasar a formato ancho: una columna binaria por categoría
ancho <- largo %>%
mutate(valor = 1) %>%
distinct(.id_fila, texto, valor) %>%
pivot_wider(
names_from = texto,
values_from = valor,
values_fill = 0,
names_prefix = prefijo
)
# 4. Unir de vuelta con la base original
resultado <- datos %>%
left_join(ancho, by = ".id_fila") %>%
select(-.id_fila)
# Las filas que no tenían respuesta quedan en NA en las dummies -> pasarlas a 0
resultado <- resultado %>%
mutate(across(starts_with(prefijo), ~ replace_na(.x, 0)))
resultado
}
# Uso:
datos_dummies <- separar_multirespuesta(deg, razones_extranjero, prefijo = "razon_")
View(datos_dummies)
sjmisc::frq(datos_dummies$`razon_El prestigio de la Universidad.`)
